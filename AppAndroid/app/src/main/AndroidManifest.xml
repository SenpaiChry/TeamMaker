<?xml version="1.0" encoding="utf-8"?>
    <manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

        <uses-permission android:name="android.permission.INTERNET" />
        <!-- Necessario per lanciare l'installer APK dall'app (aggiornamento in-app) -->
        <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

        <application
            android:name=".TeamMakerApplication"
            android:allowBackup="false"
            android:icon="@mipmap/logo_2025"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/logo_2025"
            android:supportsRtl="true"
            android:theme="@style/Theme.MyApplication"
            tools:targetApi="31">

            <activity
                android:name=".ui.activity.MainActivity"
                android:exported="true"
                android:theme="@style/Theme.MyApplication">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity>

            <activity
                android:name=".ui.activity.InfoPlayerActivity"
                android:theme="@style/NoTitleDialog" />

            <activity android:name=".ui.activity.LiveMatchActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.GenerateActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.LoginActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.AdminActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.TeamsActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.ScorecardActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.NextMatchActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.ManageTournamentActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.TeamsBracketsTableActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.ManageTeamsActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.ManageMatchesActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.activity.ManageTournamentsActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.popup.ConfirmPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.activity.EditPlayerActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.popup.SaveNewTournamentPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.popup.ManageTournamentPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.popup.GenerateTeamsPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.activity.EditMatchActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.popup.GenerateBracketPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.popup.EditTeamPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.popup.InfoMatchPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.popup.GenerateFinalsPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".ui.activity.ManageStatsActivity"
                android:theme="@style/Theme.MyApplication" />

            <activity
                android:name=".ui.popup.EditStatPopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <activity
                android:name=".update.UpdatePopupActivity"
                android:screenOrientation="portrait"
                android:theme="@style/NoTitleDialog" />

            <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
                <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths" />
            </provider>
        </application>
    </manifest>