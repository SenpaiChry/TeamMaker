<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="Theme.AppCompat.Light.NoActionBar">

        <!-- Sfondo unico del window: il gradient scorecard copre TUTTO dallo
             status bar (top) alla nav bar (bottom) senza stacchi. Prima era
             applicato sui singoli layout, causando due gradient sovrapposti
             ma disallineati (stacco visibile a livello di status bar). -->
        <item name="android:windowBackground">@drawable/bg_scoreboard</item>

        <!-- Con targetSdk 36 statusBar/navigationBar sono trasparenti a
             prescindere (edge-to-edge forzato); questi attributi restano solo
             come hint per il fallback su versioni Android piu' vecchie. -->
        <item name="android:statusBarColor">@color/scorecard_bg_top</item>
        <item name="android:navigationBarColor">@color/scorecard_bg_bottom</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>
