<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_scoreboard"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnGoBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/buttons_main"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/buttons_main"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:text="@string/make_squads"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/btnSelect"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/select_all"
            android:background="@drawable/buttons_main"
            android:tag="@string/select_all"
            android:padding="6dp"
            android:elevation="3dp" />
    </LinearLayout>

    <!-- Ricerca + contatore -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="6dp">

        <EditText
            android:id="@+id/txtSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_dark"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColorHint="@color/list_text_muted"
            android:textColor="@color/list_text_primary"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:hint="@string/search_player"
            android:drawableStart="@drawable/filter_search"
            android:drawableEnd="@drawable/filter_clear"
            android:drawableTint="@color/list_text_secondary"
            android:textSize="15sp"
            android:drawablePadding="8dp" />

        <TextView
            android:id="@+id/txtNSelected"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_counter_badge"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold"
            android:textColor="@color/list_text_primary"
            android:text="@string/zero"
            android:textSize="20sp"
            android:gravity="center" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewGenerate"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>