<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:background="@drawable/bg_modal_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:text="@string/manage_tournament"
            android:textAlignment="center"
            android:textColor="@color/list_text_primary"
            android:textSize="24sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="14dp" />

        <!-- Card dati: Nome + Data + salvataggio dedicato -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_field_secondary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_secondary"
                    android:text="@string/name"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/txtName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/bg_input_underline"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_primary"
                    android:textCursorDrawable="@null"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="8dp"
                    android:textSize="17sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_secondary"
                    android:text="@string/date"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/txtDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:background="@drawable/bg_input_underline"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_primary"
                    android:textCursorDrawable="@null"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="8dp"
                    android:textSize="17sp"
                    android:inputType="date"
                    android:focusable="false"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_modal_button_filled"
                android:backgroundTint="@color/button_confirm"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/white"
                android:text="@string/save_name_date"
                android:textSize="16sp"
                android:paddingVertical="10dp" />
        </LinearLayout>

        <!-- Naviga -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnManageTeams"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/buttons_main"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/white"
                android:text="@string/manage_teams"
                android:textSize="15sp"
                android:paddingVertical="10dp" />

            <Button
                android:id="@+id/btnManageMatches"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/buttons_main"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/white"
                android:text="@string/manage_matches"
                android:textSize="15sp"
                android:paddingVertical="10dp" />
        </LinearLayout>

        <!-- Stato -->
        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/buttons_main"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:text="@string/activate_tournament"
            android:textSize="16sp"
            android:paddingVertical="10dp" />

        <Button
            android:id="@+id/btnDeactivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/buttons_main"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:text="@string/deactivate_tournament"
            android:textSize="16sp"
            android:paddingVertical="10dp" />

        <!-- Copia (utilità secondarie) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnCopyTeams"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_modal_button_ghost"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/list_text_secondary"
                android:text="@string/copy_teams"
                android:textSize="15sp"
                android:paddingVertical="10dp" />

            <Button
                android:id="@+id/btnCopyMatches"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_modal_button_ghost"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/list_text_secondary"
                android:text="@string/copy_matches"
                android:textSize="15sp"
                android:paddingVertical="10dp" />
        </LinearLayout>

        <!-- Chiudi -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_modal_button_ghost"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/close"
            android:textSize="18sp"
            android:paddingVertical="10dp" />
    </LinearLayout>
</ScrollView>
