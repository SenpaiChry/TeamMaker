<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_margin="12dp"
    android:background="@drawable/bg_modal_dark">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColor="@color/white"
        android:text="@string/generate_finals"
        android:textAlignment="center"
        android:textSize="24sp"
        android:layout_marginBottom="10dp" />

    <com.example.myapplication.MaxHeightScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Messaggio se non ci sono abbastanza squadre -->
            <TextView
                android:id="@+id/txtNoConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/button_danger"
                android:text="@string/no_final_config"
                android:textAlignment="center"
                android:textSize="15sp"
                android:paddingVertical="12dp" />

            <!-- Toggle fase di partenza -->
            <LinearLayout
                android:id="@+id/llPhaseToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"
                android:background="@drawable/bg_field_secondary">

                <TextView
                    android:id="@+id/btnPhaseQuarter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="8dp"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_muted"
                    android:text="@string/quarter"
                    android:textAlignment="center"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnPhaseSemi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="8dp"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_muted"
                    android:text="@string/semifinal"
                    android:textAlignment="center"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnPhaseFinal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="8dp"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_muted"
                    android:text="@string/finalString"
                    android:textAlignment="center"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Finale 3°/4° posto -->
            <LinearLayout
                android:id="@+id/llThirdPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_field_secondary">

                <CheckBox
                    android:id="@+id/chkThirdPlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_secondary"
                    android:text="@string/third_place_final"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Minuti per partita -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_field_secondary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_secondary"
                    android:text="@string/minutes_for_match"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/txtMinutesForMatch"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_primary"
                    android:textColorHint="@color/list_text_muted"
                    android:hint="@string/mm"
                    android:gravity="center"
                    android:inputType="number"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Fasce orarie -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_primary"
                    android:text="@string/time_slots"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnAddTimes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/add_slot"
                    android:textSize="13sp"
                    android:background="@drawable/bg_segment_selected" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />

            <!-- Anteprima tabellone -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/list_text_primary"
                android:text="@string/preview"
                android:textSize="16sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/txtPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="italic"
                android:textColor="@color/list_text_secondary"
                android:lineSpacingMultiplier="1.25"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_field_secondary" />

            <!-- Info: partite / fasce -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/txtMatchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtNotHosted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/button_danger"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.example.myapplication.MaxHeightScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancel"
            android:background="@drawable/button_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/button_danger"
            android:text="@string/cancel"
            android:textSize="18sp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp" />

        <Button
            android:id="@+id/btnConfirm"
            android:background="@drawable/button_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:backgroundTint="@color/white"
            android:textColor="@color/button_confirm"
            android:text="@string/generate"
            android:textSize="18sp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp" />
    </LinearLayout>
</LinearLayout>
