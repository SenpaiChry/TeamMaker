<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_margin="12dp"
    android:background="@drawable/bg_modal_dark">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColor="@color/white"
        android:text="@string/title"
        android:textAlignment="center"
        android:textSize="26sp"
        android:layout_marginBottom="10dp" />

    <com.example.myapplication.MaxHeightScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Giorno + Ora (compatti, su una riga) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_field_secondary">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold|italic"
                        android:textColor="@color/list_text_secondary"
                        android:text="@string/day"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/txtDay"
                        android:layout_width="46dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold|italic"
                        android:textColor="@color/list_text_primary"
                        android:textColorHint="@color/list_text_muted"
                        android:hint="@string/n"
                        android:gravity="center"
                        android:inputType="number"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_field_secondary">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold|italic"
                        android:textColor="@color/list_text_secondary"
                        android:text="@string/time"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/txtTime"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold|italic"
                        android:textColor="@color/list_text_primary"
                        android:textColorHint="@color/list_text_muted"
                        android:hint="@string/hh_mm"
                        android:gravity="center"
                        android:inputType="time"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fase -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:background="@drawable/bg_field_secondary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_secondary"
                    android:text="@string/phase"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerPhase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:background="@drawable/select" />
            </LinearLayout>

            <!-- Squadra 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:background="@drawable/bg_field_secondary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/scorecard_team_a"
                    android:text="@string/slot_team_1"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerTeam1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:background="@drawable/select" />
            </LinearLayout>

            <!-- Squadra 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:background="@drawable/bg_field_secondary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/scorecard_team_b"
                    android:text="@string/slot_team_2"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerTeam2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:background="@drawable/select" />
            </LinearLayout>

            <!-- Risultato -->
            <LinearLayout
                android:id="@+id/llResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_field_secondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold|italic"
                        android:textColor="@color/list_text_primary"
                        android:text="@string/result"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/txtSetCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold|italic"
                        android:textColor="@color/list_text_primary"
                        android:text="@string/zero"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llSets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnAddSet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/buttons_main"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/add_set_button"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </com.example.myapplication.MaxHeightScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancel"
            android:background="@drawable/button_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/button_danger"
            android:text="@string/cancel"
            android:textSize="18sp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp" />

        <Button
            android:id="@+id/btnConfirm"
            android:background="@drawable/button_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:backgroundTint="@color/white"
            android:textColor="@color/button_confirm"
            android:text="@string/save"
            android:textSize="18sp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp" />
    </LinearLayout>
</LinearLayout>
