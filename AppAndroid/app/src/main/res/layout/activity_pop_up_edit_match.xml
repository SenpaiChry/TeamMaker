<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="5dp"
    android:layout_margin="20dp"
    android:background="@drawable/bg_modal_dark">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/white"
        android:text="@string/title"
        android:textAlignment="center"
        android:textSize="30sp"
        android:layout_marginBottom="5dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/day"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginHorizontal="20dp"
            android:layout_weight="1" />

        <EditText
            android:id="@+id/txtDay"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/black"
            android:hint="@string/n"
            android:textColorHint="@color/search_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:textAlignment="center"
            android:textSize="18sp"
            android:inputType="number"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/time"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginHorizontal="20dp"
            android:layout_weight="1" />

        <EditText
            android:id="@+id/txtTime"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/black"
            android:hint="@string/hh_mm"
            android:textColorHint="@color/search_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:textAlignment="center"
            android:textSize="18sp"
            android:inputType="time"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:padding="10dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/phase"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginEnd="10dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerPhase"
            android:fontFamily="@font/helvetica_black"
            android:background="@drawable/select"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_weight="2.2"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:padding="10dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/team_1"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginEnd="10dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerTeam1"
            android:fontFamily="@font/helvetica_black"
            android:background="@drawable/select"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_weight="2.2"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:padding="5dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/team_2"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginEnd="10dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerTeam2"
            android:fontFamily="@font/helvetica_black"
            android:background="@drawable/select"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_weight="2.2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llPoints1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="5dp"
        android:background="@drawable/player_style"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:lineSpacingMultiplier="1.1"
            android:text="@string/points_1"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold|italic" />

        <EditText
            android:id="@+id/txtPoints1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:inputType="number"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llPoints2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/points_2"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginHorizontal="20dp"
            android:layout_weight="1"/>

        <EditText
            android:id="@+id/txtPoints2"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:textAlignment="center"
            android:textSize="18sp"
            android:inputType="number"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="5dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancel"
            android:background="@drawable/button_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/button_danger"
            android:text="@string/cancel"
            android:textSize="18sp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp" />

        <Button
            android:id="@+id/btnConfirm"
            android:background="@drawable/button_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:backgroundTint="@color/white"
            android:textColor="@color/button_confirm"
            android:text="@string/save"
            android:textSize="18sp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp" />
    </LinearLayout>
</LinearLayout>