<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="5dp"
    android:gravity="center"
    android:layout_margin="20dp"
    android:background="@drawable/bg_modal_dark">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/white"
        android:text="@string/title"
        android:textAlignment="center"
        android:textSize="30sp"
        android:layout_marginBottom="5dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:padding="7dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/player_1"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginEnd="5dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerPlayer1"
            android:fontFamily="@font/helvetica_black"
            android:background="@drawable/select"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_weight="1.5"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:padding="7dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/player_2"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginEnd="5dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerPlayer2"
            android:fontFamily="@font/helvetica_black"
            android:background="@drawable/select"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_weight="1.5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:padding="7dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/player_3"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginEnd="5dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerPlayer3"
            android:fontFamily="@font/helvetica_black"
            android:background="@drawable/select"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_weight="1.5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:padding="7dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/player_4"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginEnd="5dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerPlayer4"
            android:fontFamily="@font/helvetica_black"
            android:background="@drawable/select"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_weight="1.5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="5dp"
        android:padding="7dp"
        android:background="@drawable/player_style">

        <TextView
            android:layout_width="0dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/black"
            android:layout_height="wrap_content"
            android:text="@string/player_5"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginEnd="5dp"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spinnerPlayer5"
            android:fontFamily="@font/helvetica_black"
            android:background="@drawable/select"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_weight="1.5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="5dp">

        <Button
            android:id="@+id/btnCancel"
            android:background="@drawable/button_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/button_danger"
            android:text="@string/cancel"
            android:textSize="18sp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"/>

        <Button
            android:id="@+id/btnConfirm"
            android:background="@drawable/button_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:backgroundTint="@color/white"
            android:textColor="@color/button_confirm"
            android:text="@string/save"
            android:textSize="18sp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"/>
    </LinearLayout>
</LinearLayout>