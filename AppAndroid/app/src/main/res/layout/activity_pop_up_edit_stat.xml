<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="18dp"
        android:background="@drawable/bg_bottom_sheet">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_handle_bar" />

        <!-- Title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_primary"
            android:text="@string/stat_new_title"
            android:textSize="22sp"
            android:layout_marginBottom="18dp" />

        <!-- Nome label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/stat_name_label"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <!-- Nome input -->
        <EditText
            android:id="@+id/txtLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field_secondary"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_primary"
            android:textColorHint="@color/list_text_muted"
            android:textCursorDrawable="@null"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:textSize="16sp"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <!-- Tipo label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/stat_type_label"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <!-- Type toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="@drawable/bg_field_secondary">

            <LinearLayout
                android:id="@+id/btnTypeStars"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_segment_selected">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_stat_star"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/stat_stars_type"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnTypeRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_stat_bars"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_muted"
                    android:text="@string/stat_range_type"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== Steppers row (visible for both types) ======== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- Valore massimo (stars only) -->
            <LinearLayout
                android:id="@+id/llMaxStepper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="italic"
                    android:textColor="@color/list_text_secondary"
                    android:text="@string/stat_max_value_label"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_field_secondary"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/btnMaxMinus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textAlignment="center"
                        android:textColor="@color/list_text_primary"
                        android:textSize="18sp"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/txtMax"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold|italic"
                        android:textColor="@color/list_text_primary"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:text="4" />

                    <TextView
                        android:id="@+id/btnMaxPlus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+"
                        android:textAlignment="center"
                        android:textColor="@color/list_text_primary"
                        android:textSize="18sp"
                        android:paddingVertical="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ogni stella/fascia vale -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/txtStepLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="italic"
                    android:textColor="@color/list_text_secondary"
                    android:text="@string/stat_each_star_value"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_field_secondary"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/btnStepMinus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textAlignment="center"
                        android:textColor="@color/list_text_primary"
                        android:textSize="18sp"
                        android:paddingVertical="6dp" />

                    <TextView
                        android:id="@+id/txtStep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold|italic"
                        android:textColor="@color/list_text_primary"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:text="1" />

                    <TextView
                        android:id="@+id/btnStepPlus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+"
                        android:textAlignment="center"
                        android:textColor="@color/list_text_primary"
                        android:textSize="18sp"
                        android:paddingVertical="6dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ======== STARS section (bonus + preview) ======== -->
        <LinearLayout
            android:id="@+id/llStarsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stella bonus row -->
            <LinearLayout
                android:id="@+id/llAllowBonus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_field_secondary">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_stars"
                    android:text="★"
                    android:textColor="@color/stars"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingTop="2dp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_primary"
                    android:text="@string/stat_bonus_star"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBonus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Preview row -->
            <LinearLayout
                android:id="@+id/llPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_field_secondary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_muted"
                    android:text="@string/stat_preview_label"
                    android:textSize="12sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:id="@+id/previewStars"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/txtPreviewRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="italic"
                    android:textColor="@color/list_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== RANGE section: values list ======== -->
        <LinearLayout
            android:id="@+id/llValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/list_text_primary"
                    android:text="@string/stat_values"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnAddValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/add_slot"
                    android:textSize="13sp"
                    android:background="@drawable/bg_segment_selected" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/llValuesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- Bottom buttons: delete + save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_field_secondary"
                android:src="@drawable/player_delete"
                android:padding="12dp"
                app:tint="@color/button_danger"
                android:contentDescription="@string/delete"
                android:layout_marginEnd="10dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/buttons_main"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/white"
                android:text="@string/save"
                android:textSize="18sp"
                android:paddingVertical="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
