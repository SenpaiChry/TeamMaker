<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_margin="12dp"
    android:background="@drawable/bg_modal_dark">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColor="@color/white"
        android:text="@string/new_stat"
        android:textAlignment="center"
        android:textSize="22sp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="6dp" />

    <!-- Label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_field_secondary">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/stat_label"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/txtLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:background="@null"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_primary"
            android:textColorHint="@color/list_text_muted"
            android:textCursorDrawable="@null"
            android:gravity="end"
            android:paddingVertical="6dp"
            android:textSize="16sp"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- Type toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field_secondary">

        <TextView
            android:id="@+id/btnTypeStars"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:text="@string/stat_type_stars"
            android:textAlignment="center"
            android:textSize="13sp"
            android:background="@drawable/bg_segment_selected" />

        <TextView
            android:id="@+id/btnTypeRange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_muted"
            android:text="@string/stat_type_range"
            android:textAlignment="center"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Max (solo STARS) -->
    <LinearLayout
        android:id="@+id/llMax"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_field_secondary">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/stat_max"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/txtMax"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_primary"
            android:textColorHint="@color/list_text_muted"
            android:textCursorDrawable="@null"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- Step (STARS e RANGE) -->
    <LinearLayout
        android:id="@+id/llStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_field_secondary">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/stat_step"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/txtStep"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_primary"
            android:textColorHint="@color/list_text_muted"
            android:textCursorDrawable="@null"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- Ammette bonus (solo STARS) -->
    <LinearLayout
        android:id="@+id/llAllowBonus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_field_secondary">

        <CheckBox
            android:id="@+id/chkAllowBonus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/stat_allow_bonus"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Values (solo RANGE) -->
    <LinearLayout
        android:id="@+id/llValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/list_text_primary"
                android:text="@string/stat_values"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnAddValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/white"
                android:text="@string/add_slot"
                android:textSize="13sp"
                android:background="@drawable/bg_segment_selected" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/llValuesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancel"
            android:background="@drawable/bg_modal_button_ghost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/cancel"
            android:textSize="18sp"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="5dp" />

        <Button
            android:id="@+id/btnConfirm"
            android:background="@drawable/bg_modal_button_filled"
            android:backgroundTint="@color/button_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:text="@string/save"
            android:textSize="18sp"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="5dp" />
    </LinearLayout>
</LinearLayout>
