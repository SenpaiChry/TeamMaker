<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_modal_dark">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColor="@color/list_text_primary"
        android:text="@string/title"
        android:textAlignment="center"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="20sp"
        android:autoSizeMaxTextSize="28sp"
        android:layout_marginBottom="10dp" />

    <!-- NOME -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/name"
            android:textSize="18sp"
            android:textAlignment="center" />

        <EditText
            android:id="@+id/txtName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_input_underline"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_primary"
            android:textCursorDrawable="@null"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp"
            android:textSize="17sp"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- COGNOME -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/surname"
            android:textSize="18sp"
            android:textAlignment="center" />

        <EditText
            android:id="@+id/txtSurname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_input_underline"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_primary"
            android:textCursorDrawable="@null"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp"
            android:textSize="17sp"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- SOPRANNOME -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/nickname"
            android:textSize="18sp"
            android:textAlignment="center" />

        <EditText
            android:id="@+id/txtNickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_input_underline"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_primary"
            android:textCursorDrawable="@null"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp"
            android:textSize="17sp"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- SESSO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/list_text_secondary"
            android:text="@string/gender"
            android:textSize="18sp"
            android:textAlignment="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnGenderM"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_margin="4dp"
                android:padding="0dp"
                android:background="@drawable/bg_gender_unselected"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:text="M"
                android:textColor="@color/list_text_primary" />

            <Button
                android:id="@+id/btnGenderF"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_margin="4dp"
                android:padding="0dp"
                android:background="@drawable/bg_gender_unselected"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:text="F"
                android:textColor="@color/list_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- STATISTICHE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:text="@string/stats"
        android:textColor="@color/list_text_primary"
        android:textSize="26sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <ListView
        android:id="@+id/listStats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingVertical="2dp" />

    <!-- AZIONI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_modal_cancel"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/button_danger"
            android:text="@string/cancel"
            android:textSize="18sp"
            android:paddingVertical="10dp" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_modal_ok"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/button_confirm"
            android:text="@string/save"
            android:textSize="18sp"
            android:paddingVertical="10dp" />
    </LinearLayout>
</LinearLayout>