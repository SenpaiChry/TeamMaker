<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_scoreboard">

    <!-- ============================ TOP BAR ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnGoBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/buttons_main"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back"
            android:scaleType="fitCenter"
            android:padding="10dp" />

        <TextView
            android:id="@+id/txtTournament"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:text="@string/tournament"
            android:textAllCaps="true"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="30sp"
            android:textColor="@color/list_text_primary"
            android:paddingHorizontal="8dp" />

        <!-- Spazio speculare al tasto indietro, per centrare il titolo -->
        <Space
            android:layout_width="42dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- ============================ TAB ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/btnTeams"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_main_selected"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingHorizontal="4dp"
            android:text="@string/teams" />

        <Button
            android:id="@+id/btnBracket"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/buttons_main"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingHorizontal="4dp"
            android:text="@string/matches" />

        <Button
            android:id="@+id/btnTable"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/buttons_main"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:paddingHorizontal="4dp"
            android:text="@string/table" />
    </LinearLayout>

    <!-- ============================ RICERCA ============================ -->
    <EditText
        android:id="@+id/txtSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_dark"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColorHint="@color/list_text_muted"
        android:textColor="@color/list_text_primary"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:hint="@string/search_player"
        android:drawableStart="@drawable/filter_search"
        android:drawableEnd="@drawable/filter_clear"
        android:drawableTint="@color/list_text_secondary"
        android:textSize="15sp"
        android:drawablePadding="8dp" />

    <!-- ============================ LISTE ============================ -->
    <ListView
        android:id="@+id/listViewTeams"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <ListView
        android:id="@+id/listViewBracket"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listViewTable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone" />

</LinearLayout>