<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llInfo"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="46dp"
    android:background="@drawable/bg_stat_row"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- COL 1: NOME -->
    <TextView
        android:id="@+id/txtStatsDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColor="@color/list_text_primary"
        android:text="@string/description"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_marginEnd="10dp" />

    <!-- COL 2: STELLE (spinner per RANGE, stelle per STARS con wrap) -->
    <Spinner
        android:id="@+id/spinnerValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="90dp"
        android:background="@drawable/select"
        android:popupBackground="@drawable/bg_spinner_popup"
        android:gravity="center" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/llImages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:flexWrap="wrap"
        app:justifyContent="flex_end"
        app:alignItems="center" />

    <!-- COL 3: BONUS (sempre presente, riservato) -->
    <ImageView
        android:id="@+id/imgBonus"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/star_full"
        android:visibility="invisible" />
</LinearLayout>
