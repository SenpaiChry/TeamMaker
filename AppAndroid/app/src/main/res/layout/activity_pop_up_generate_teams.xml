<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:gravity="center"
    android:background="@drawable/bg_modal_dark">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:text="@string/generate_teams"
        android:textAlignment="center"
        android:textColor="@color/list_text_primary"
        android:textSize="26sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="14dp" />

    <!-- Giocatori per squadra -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:text="@string/player_per_squad"
        android:textColor="@color/list_text_secondary"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="18dp">

        <Button
            android:id="@+id/btnNPlayer2"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="4dp"
            android:padding="0dp"
            android:background="@drawable/bg_gender_unselected"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:text="2"
            android:textColor="@color/list_text_primary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnNPlayer3"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="4dp"
            android:padding="0dp"
            android:background="@drawable/bg_gender_unselected"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:text="3"
            android:textColor="@color/list_text_primary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnNPlayer4"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="4dp"
            android:padding="0dp"
            android:background="@drawable/bg_gender_unselected"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:text="4"
            android:textColor="@color/list_text_primary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnNPlayer5"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="4dp"
            android:padding="0dp"
            android:background="@drawable/bg_gender_unselected"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:text="5"
            android:textColor="@color/list_text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar1"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateTint="@color/button_confirm"
        android:indeterminateTintMode="src_in"
        android:layout_marginBottom="10dp" />

    <!-- Azioni -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_modal_cancel"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/button_danger"
            android:text="@string/cancel"
            android:textSize="18sp"
            android:paddingVertical="10dp" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_modal_ok"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/button_confirm"
            android:text="@string/confirm"
            android:textSize="18sp"
            android:paddingVertical="10dp" />
    </LinearLayout>
</LinearLayout>