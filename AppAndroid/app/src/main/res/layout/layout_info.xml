<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="12dp"
    android:background="@drawable/bg_stat_row">

    <!-- COL 1: NOME -->
    <TextView
        android:id="@+id/txtName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="@string/description"
        android:textColor="@color/list_text_primary"
        android:textSize="14sp"
        android:paddingVertical="2dp"
        android:paddingEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic" />

    <!-- COL 2: STELLE / FASCIA -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/llImages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:flexWrap="wrap"
        app:justifyContent="flex_end"
        app:alignItems="center">

        <TextView
            android:id="@+id/txtHeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/height_vote"
            android:textColor="@color/list_text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:visibility="gone" />
    </com.google.android.flexbox.FlexboxLayout>

    <!-- COL 3: BONUS -->
    <ImageView
        android:id="@+id/imgBonus"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/star_full"
        android:visibility="invisible" />
</LinearLayout>
