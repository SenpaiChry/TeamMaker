<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_scoreboard">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnGoBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/buttons_main"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnReroll"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/buttons_main"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:text="@string/reroll" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/buttons_main"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:text="@string/save" />
    </LinearLayout>

    <!-- Info -->
    <TextView
        android:id="@+id/txtMaxDifference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColor="@color/list_text_primary"
        android:textSize="16sp"
        android:textAlignment="center"
        android:text="@string/max_difference"
        android:layout_marginVertical="2dp" />

    <TextView
        android:id="@+id/txtN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColor="@color/list_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:text="@string/cycle"
        android:layout_marginBottom="4dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateTint="@color/button_confirm"
        android:indeterminateTintMode="src_in" />

    <ListView
        android:id="@+id/listViewTeams"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>