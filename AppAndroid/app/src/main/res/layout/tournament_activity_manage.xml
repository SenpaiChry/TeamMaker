<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_scoreboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnGoBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/buttons_main"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back"
            android:scaleType="fitCenter"
            android:padding="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:text="@string/manage"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:textColor="@color/list_text_primary"
            android:textSize="26sp" />

        <Space
            android:layout_width="42dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Card 1: icona SX, testo DX -->
        <LinearLayout
            android:id="@+id/btnManagePlayers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/buttons_main"
            android:padding="14dp"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/player"
                android:scaleType="fitCenter"
                android:contentDescription="@string/players" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:text="@string/players"
                android:textAllCaps="true"
                android:textAlignment="center"
                android:textSize="22sp"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Card 2: testo SX, icona DX -->
        <LinearLayout
            android:id="@+id/btnManageTournament"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/buttons_main"
            android:padding="14dp"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:text="@string/tournaments"
                android:textAllCaps="true"
                android:textAlignment="center"
                android:textSize="22sp"
                android:textColor="@color/white" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/trophy"
                android:scaleType="fitCenter"
                android:contentDescription="@string/tournaments" />
        </LinearLayout>

        <!-- Card 3: icona SX, testo DX -->
        <LinearLayout
            android:id="@+id/btnManageStats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/buttons_main"
            android:padding="14dp"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/star_full"
                android:scaleType="fitCenter"
                android:tint="@color/black"
                android:contentDescription="@string/stats" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:text="@string/stats"
                android:textAllCaps="true"
                android:textAlignment="center"
                android:textSize="22sp"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>