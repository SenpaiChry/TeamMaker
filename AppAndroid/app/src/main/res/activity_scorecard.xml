<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/___bg_scoreboard"
    android:paddingHorizontal="8dp">

    <!-- ============================ TOP BAR ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp">

        <ImageButton
            android:id="@+id/btnGoBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/buttons_main"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back"
            android:scaleType="fitCenter"
            android:padding="10dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/buttons_main"
            android:src="@drawable/___ic_rotate"
            android:contentDescription="@string/rotate"
            android:scaleType="fitCenter"
            android:layout_marginHorizontal="4dp"
            android:padding="9dp" />

        <Button
            android:id="@+id/btnNextMatch"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/buttons_main"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:text="@string/next_match"
            android:textSize="17sp"
            android:paddingHorizontal="14dp"
            android:layout_marginHorizontal="4dp" />

    </LinearLayout>

    <!-- ========================= NEXT MATCH MARQUEE ========================= -->
    <!-- NB: per far scorrere serve txtNextMatchMarquee.setSelected(true) nel codice -->
    <TextView
        android:id="@+id/txtNextMatchMarquee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/___bg_marquee"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollHorizontally="true"
        android:text="@string/next_match_marquee"
        android:fontFamily="@font/helvetica_black"
        android:textStyle="bold|italic"
        android:textColor="#08343B"
        android:textSize="16sp"
        android:textAllCaps="true"
        android:gravity="center"
        android:paddingVertical="7dp"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp" />

    <!-- ===================== TEAM NAMES (modalità generica) ===================== -->
    <LinearLayout
        android:id="@+id/llGenericTeam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/txtTeam1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="#3FC4D2"
            android:text="@string/team_1"
            android:textSize="24sp"
            android:padding="4dp"
            android:gravity="center" />

        <Space
            android:layout_width="100dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/txtTeam2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/helvetica_black"
            android:textStyle="bold|italic"
            android:textColor="#F2994A"
            android:text="@string/team_2"
            android:textSize="24sp"
            android:padding="4dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- ==================== TEAM PLAYERS (modalità torneo) ==================== -->
    <LinearLayout
        android:id="@+id/llTournamentTeam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Team 1 -->
        <LinearLayout
            android:id="@+id/llTeam1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtTeam1Player1Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/player_1"
                    android:textSize="15sp"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/txtTeam1Player2Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/player_2"
                    android:textSize="15sp"
                    android:textAlignment="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTeam1Player34"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtTeam1Player3Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/player_3"
                    android:textSize="15sp"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/txtTeam1Player4Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/player_4"
                    android:textSize="15sp"
                    android:textAlignment="center" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTeam1Player5Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/white"
                android:text="@string/player_5"
                android:textSize="15sp"
                android:textAlignment="center" />
        </LinearLayout>

        <Space
            android:layout_width="100dp"
            android:layout_height="1dp" />

        <!-- Team 2 -->
        <LinearLayout
            android:id="@+id/llTeam2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtTeam2Player1Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/player_1"
                    android:textSize="15sp"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/txtTeam2Player2Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/player_2"
                    android:textSize="15sp"
                    android:textAlignment="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTeam2Player34"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/txtTeam2Player3Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/player_3"
                    android:textSize="15sp"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/txtTeam2Player4Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/helvetica_black"
                    android:textStyle="bold|italic"
                    android:textColor="@color/white"
                    android:text="@string/player_4"
                    android:textSize="15sp"
                    android:textAlignment="center" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTeam2Player5Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold|italic"
                android:textColor="@color/white"
                android:text="@string/player_5"
                android:textSize="15sp"
                android:textAlignment="center" />
        </LinearLayout>

    </LinearLayout>

    <!-- ============================ POINTS + SETS ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="6dp">

        <!-- Pannello punti Team 1 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/___bg_score_panel_team1"
            android:layout_marginHorizontal="4dp">

            <TextView
                android:id="@+id/txtPoints1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold"
                android:text="@string/points"
                android:textColor="#3FC4D2"
                android:gravity="center"
                android:includeFontPadding="false"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="60sp"
                app:autoSizeMaxTextSize="150sp"
                tools:text="0" />
        </FrameLayout>

        <!-- Colonna centrale: VS + set -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Set Team 1 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btnPlusSet1"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/score_button"
                        android:contentDescription="@string/add_set"
                        android:src="@drawable/score_add"
                        android:scaleType="fitCenter"
                        android:padding="4dp" />

                    <TextView
                        android:id="@+id/txtSets1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/sets_value"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:text="@string/zero"
                        android:layout_marginVertical="5dp"
                        android:textSize="24sp"
                        android:gravity="center"
                        tools:text="0" />

                    <ImageButton
                        android:id="@+id/btnMinusSet1"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/score_button"
                        android:contentDescription="@string/remove_set"
                        android:src="@drawable/score_remove"
                        android:scaleType="fitCenter"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Set Team 2 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btnPlusSet2"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/score_button"
                        android:contentDescription="@string/add_set"
                        android:src="@drawable/score_add"
                        android:scaleType="fitCenter"
                        android:padding="4dp" />

                    <TextView
                        android:id="@+id/txtSets2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/sets_value"
                        android:fontFamily="@font/helvetica_black"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:text="@string/zero"
                        android:layout_marginVertical="5dp"
                        android:textSize="24sp"
                        android:gravity="center"
                        tools:text="0" />

                    <ImageButton
                        android:id="@+id/btnMinusSet2"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/score_button"
                        android:contentDescription="@string/remove_set"
                        android:src="@drawable/score_remove"
                        android:scaleType="fitCenter"
                        android:padding="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Pannello punti Team 2 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/___bg_score_panel_team2"
            android:layout_marginHorizontal="4dp">

            <TextView
                android:id="@+id/txtPoints2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/helvetica_black"
                android:textStyle="bold"
                android:text="@string/points"
                android:textColor="#F2994A"
                android:gravity="center"
                android:includeFontPadding="false"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="60sp"
                app:autoSizeMaxTextSize="150sp"
                tools:text="0" />
        </FrameLayout>
    </LinearLayout>

    <!-- ============================ POINT BUTTONS ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnMinusPoint1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/score_button"
                android:contentDescription="@string/remove_point"
                android:src="@drawable/score_remove"
                android:scaleType="fitCenter"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/btnPlusPoint1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/score_button"
                android:contentDescription="@string/add_point"
                android:src="@drawable/score_add"
                android:scaleType="fitCenter"
                android:padding="8dp" />
        </LinearLayout>

        <Space
            android:layout_width="100dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnMinusPoint2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/score_button"
                android:contentDescription="@string/remove_point"
                android:src="@drawable/score_remove"
                android:scaleType="fitCenter"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/btnPlusPoint2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/score_button"
                android:contentDescription="@string/add_point"
                android:src="@drawable/score_add"
                android:scaleType="fitCenter"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>