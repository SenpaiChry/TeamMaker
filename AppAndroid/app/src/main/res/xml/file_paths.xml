<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cartella exports/ dentro la cache app: le esportazioni Excel finiscono qui -->
    <cache-path name="exports" path="exports/" />
