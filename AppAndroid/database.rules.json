{
  "rules": {
    ".read": false,
    ".write": false,

    "teammaker": {
      "admins": {
        ".read": "auth != null",
        ".write": false
      },
      "admin-pw": {
        ".read": false,
        ".write": false
      },
      "live_match": {
        ".read": true,
        ".write": "auth != null && root.child('teammaker/admins').child(auth.uid).exists()"
      },
      "stats": {
        ".read": true,
        ".write": "auth != null && root.child('teammaker/admins').child(auth.uid).exists()"
      },
      "players": {
        ".read": true,
        ".write": "auth != null && root.child('teammaker/admins').child(auth.uid).exists()"
      },
      "tournaments": {
        ".read": true,
        ".write": "auth != null && root.child('teammaker/admins').child(auth.uid).exists()"
      }
    },

    "teammakerStaging": {
      "admins": {
        ".read": "auth != null",
        ".write": false
      },
      "live_match": {
        ".read": true,
        ".write": "auth != null && root.child('teammaker/admins').child(auth.uid).exists()"
      },
      "stats": {
        ".read": true,
        ".write": "auth != null && root.child('teammaker/admins').child(auth.uid).exists()"
      },
      "players": {
        ".read": true,
        ".write": "auth != null && root.child('teammaker/admins').child(auth.uid).exists()"
      },
      "tournaments": {
        ".read": true,
        ".write": "auth != null && root.child('teammaker/admins').child(auth.uid).exists()"
      }
    },

    "dbEmpty": {
      ".read": false,
      ".write": false
    },
    "dbRizzi": {
      ".read": false,
      ".write": false
    }
  }
}
