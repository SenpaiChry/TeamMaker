# Esempio di keystore.properties.
# Copia questo file come "keystore.properties" (stessa cartella, senza .example)
# e riempi i valori con le tue password / path del keystore locale.
#
# Il file "keystore.properties" e' gitignored: le password NON finiscono su git.
# Se non esiste, la build DEBUG funziona lo stesso; la build RELEASE fallisce
# con un messaggio esplicito.

storeFile=C:/Users/chri/keystores/teammaker-release.jks
storePassword=INSERISCI_PASSWORD_KEYSTORE
keyAlias=teammaker
keyPassword=INSERISCI_PASSWORD_CHIAVE
