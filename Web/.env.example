# Configurazione Firebase per la web app.
#
# Copia questo file in `.env.local` (che è escluso dal repository) e riempi i
# valori mancanti. Li trovi nella console Firebase del progetto team-maker-d811f:
#   Impostazioni progetto → Le tue app → Aggiungi app → Web
# Registra una app web (l'apiKey dell'app Android non vale per il web) e copia
# qui i valori dello snippet di configurazione.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=team-maker-d811f.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://team-maker-d811f-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=team-maker-d811f
VITE_FIREBASE_STORAGE_BUCKET=team-maker-d811f.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1096361966380
VITE_FIREBASE_APP_ID=

# Radice del database. In sviluppo si usa lo staging, così l'app Android e i
# dati reali non vengono toccati. La barra finale è obbligatoria.
VITE_DB_ROOT=teammakerStaging/
