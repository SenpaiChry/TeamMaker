# Configurazione usata da `npm run build`, cioè dalla versione pubblicata.
#
# Nessuno di questi valori è segreto: la configurazione Firebase per il web è
# pubblica per progetto, e la protezione del database sono le sue regole, non
# queste variabili. Per questo il file è versionato: così una ripubblicazione
# dà sempre lo stesso risultato.
#
# ⚠️ L'app pubblicata punta allo STAGING. Per passare ai dati reali, condivisi
# con l'app Android, cambiare VITE_DB_ROOT in `teammaker/` e ripubblicare.

VITE_FIREBASE_DATABASE_URL=https://team-maker-d811f-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=team-maker-d811f
VITE_FIREBASE_AUTH_DOMAIN=team-maker-d811f.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=team-maker-d811f.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1096361966380

VITE_DB_ROOT=teammakerStaging/

# apiKey e appId servono solo all'autenticazione, non ancora usata.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# Password dell'area di gestione. Lasciata vuota di proposito: su staging
# l'area resta aperta. Non ha senso metterla qui, perche' finirebbe nel bundle
# JavaScript pubblicato e sarebbe leggibile da chiunque; vale come promemoria
# che la protezione vera sono le regole del database.
VITE_ADMIN_PASSWORD=
